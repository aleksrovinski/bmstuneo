# Xray (VLESS Reality) owns :443 and forwards ordinary HTTPS visitors here, to 127.0.0.1:8443
{
	https_port 8443

	# Xray prepends a PROXY protocol header with the visitor's real address (realitySettings
	# "xver": 1), otherwise every visitor looks like 127.0.0.1 and the push server's per-IP
	# rate limit becomes one limit shared by everyone. Needs Caddy 2.7+.
	# Turn both sides on together: without the header from Xray, or without this wrapper
	# in Caddy, TLS on 8443 breaks.
	servers 127.0.0.1:8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
}

http://bmstuneo.xyz {
	redir https://bmstuneo.xyz{uri} 301
}

# One domain for both: the push API under /v1 and /healthz, the landing page for everything else.
bmstuneo.xyz {
	bind 127.0.0.1
	encode zstd gzip

	handle /v1/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}
	# /internal/tick stays reachable only from the server itself (curl 127.0.0.1:8080)
	handle /internal/* {
		respond 404
	}

	handle {
		root * /var/www/bmstuneo
		file_server
		# Pages, scripts and the update manifest change with every release: always revalidate,
		# so the download button never points at an APK that was already replaced
		@revalidate path / *.html *.js *.css /version.json
		header @revalidate Cache-Control no-cache
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
	}
}
